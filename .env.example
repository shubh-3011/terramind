# Analyzer service
TERRAMIND_HOST=127.0.0.1
TERRAMIND_PORT=8000
TERRAMIND_WORKSPACE_ROOT=

# Local LLM (Ollama). Do not place credentials here.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional analyzer executable overrides. Leave blank to use PATH.
TERRAFORM_BIN=terraform
TFLINT_BIN=tflint
CHECKOV_BIN=checkov
